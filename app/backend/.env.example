# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Sessions
DATABASE_URL=sqlite:///./second_brain.db
SESSION_SECRET=your-super-secret-session-key
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Supabase Auth & Storage (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=second_brain

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=3072
GENERATION_MODEL=gemini-3.1-flash-lite

# Voice Provider ("auto" | "elevenlabs" | "jsflabs")
# "auto" automatically picks ElevenLabs if ELEVENLABS_API_KEY is set, otherwise falls back to JSF Labs.
VOICE_PROVIDER=auto

# ElevenLabs Voice API (TTS & Real-Time Conversational AI)
# 1. Developer API Key (or ELEVENLABS_API_KEYS for comma-separated key rotation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_KEYS=

# 2. Cloned or Default Voice ID (Default: JBFqnCBsd6RMkjVDRZzb (George), or your cloned creator voice ID)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# 3. Model ID (eleven_multilingual_v2 for best multilingual & Roman Urdu pronunciation, or eleven_turbo_v2_5 for ultra-low latency)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 4. Optional Conversational AI Agent ID (from ElevenLabs ConvAI dashboard, e.g. agent_...)
ELEVENLABS_CONVAI_AGENT_ID=

# 5. Voice Generation Settings
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_SPEED=1.0

# JSF Labs Voice API (Fallback TTS & Voice Cloning)
# 1. Fast Inference Dashboard Session (Optional, uses your dashboard credits directly!)
JSF_USER_ID=your_user_id_from_dashboard_here

# 2. Developer API Key(s)
JSF_API_KEY=your_jsf_api_key_here
JSF_API_KEYS=your_first_key,your_second_key

# 3. Voice ID & Speed
JSF_VOICE_ID=jsf_default_male
JSF_TTS_SPEED=1.0
