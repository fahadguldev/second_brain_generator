{
  "version": 2,
  "builds": [
    {
      "src": "app/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "app/backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/backend/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "app/frontend/assets/$1"
    },
    {
      "src": "/((?!api/).*\\.(?:js|css|ico|svg|png|jpg|jpeg|webp|woff|woff2|json|txt))$",
      "dest": "app/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/frontend/index.html"
    }
  ]
}
